NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/my_service_app

# Redis: bitmap state + pub/sub + fixed-window rate limits
REDIS_URL=redis://localhost:6379

APP_BASE_URL=http://localhost:4000
SESSION_COOKIE_NAME=app_sid
SESSION_TTL_DAYS=30

APP_DATA_ENCRYPTION_KEY=CHANGE_THIS_TO_A_RANDOM_32_BYTE_BASE64_KEY

# 1000×1000 = 1_000_000 checkboxes (compact Redis bitmap). Use smaller values locally if needed.
GRID_COLS=1000
GRID_ROWS=1000

# Optional stable id in logs / pub/sub (defaults to hostname-pid)
# INSTANCE_ID=worker-1

# Custom HTTP rate limits (Redis fixed-window; see README)
# RL_LOGIN_PER_WINDOW=20
# RL_LOGIN_WINDOW_SEC=900
# RL_CALLBACK_PER_WINDOW=60
# RL_CALLBACK_WINDOW_SEC=900
# RL_API_PER_WINDOW=300
# RL_API_WINDOW_SEC=60
# RL_TOGGLE_PER_MIN=5

AUTH_ISSUER=http://localhost:3000
AUTH_AUTHORIZATION_ENDPOINT=http://localhost:3000/authorize
AUTH_TOKEN_ENDPOINT=http://localhost:3000/token
AUTH_USERINFO_ENDPOINT=http://localhost:3000/userinfo
AUTH_JWKS_URI=http://localhost:3000/jwks.json
AUTH_REVOKE_ENDPOINT=http://localhost:3000/revoke

AUTH_CLIENT_ID=your_client_id_here
AUTH_CLIENT_SECRET=your_client_secret_here
AUTH_REDIRECT_URI=http://localhost:4000/callback
AUTH_SCOPES=openid profile email
